{
  "name": "@ssot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Anillo 4 - Consola de administracion (React + Vite). UC-01, UC-11, UC-12.",
  "main": "./src/main.tsx",
  "scripts": {
    "generate:api-client": "orval --config orval.config.ts",
    "predev": "pnpm run generate:api-client",
    "dev": "vite",
    "prebuild": "pnpm run generate:api-client",
    "build": "tsc --noEmit && vite build",
    "pretest": "pnpm run generate:api-client",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "@tanstack/react-query": "^5.103.1",
    "@supabase/supabase-js": "^2.116.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "clsx": "^2.1.1",
    "@ssot/a11y": "workspace:*",
    "@ssot/contracts": "workspace:*",
    "@ssot/design-tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "orval": "^8.34.0",
    "msw": "^2.15.0",
    "jsdom": "^30.1.0",
    "jest-axe": "^11.0.0",
    "@types/jest-axe": "^3.5.9",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7"
  }
}
