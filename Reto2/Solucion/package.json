{
  "name": "ssot-contacts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Plataforma de Centralizacion de Contactos (SSOT) - Reto 2",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "dep-cruise": "depcruise --config .dependency-cruiser.cjs apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
