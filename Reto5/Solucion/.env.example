# Modo de persistencia: sqlite | supabase-local | supabase-cloud
RETO5_PERSISTENCE=sqlite
RETO5_SQLITE_PATH=data/auditoria.db

# Supabase local (supabase start)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<local-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
SUPABASE_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
SUPABASE_STORAGE_BUCKET=documents

# LLM local (Ollama) — nunca en CI
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM remoto (opcional, solo dev/demo; CI usa cassettes VCR)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Rutas de ingesta
RETO5_WATCH_DIR=./Documentos
RETO5_OUTPUT_DIR=./data/organizado
