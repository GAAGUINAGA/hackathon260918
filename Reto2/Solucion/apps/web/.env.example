# Copiar a .env.local (nunca versionar). Fase 5, Anillo 4.

# ADR-05: Supabase Auth es el único IdP. La consola nunca lee tablas con
# supabase-js (planeacion v2.1.2, "Identidad"); estas claves solo
# gestionan el ciclo de sesión (login/logout/refresh).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Origen de apps/api (Fase 4). En local, el puerto de infra/.env.example.
VITE_API_BASE_URL=http://localhost:3000
