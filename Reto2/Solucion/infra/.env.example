# Copiar a .env (nunca versionar .env real) y ajustar segun el entorno local.

POSTGRES_USER=ssot_admin
POSTGRES_PASSWORD=ssot_local_dev
POSTGRES_DB=ssot_contacts
POSTGRES_PORT=5432

REDIS_PORT=6379

# Fase 3: roles de base de datos de privilegio minimo (ADR-04, ADR-11).
# app_rw es el unico rol con el que se conecta la aplicacion (apps/api,
# apps/worker para casos de uso); nunca service_role ni el propietario de
# las tablas. app_relay es un rol aparte, acotado EXCLUSIVAMENTE a la tabla
# outbox (RT-04 S4.2): el rele procesa lotes de muchos propietarios a la
# vez, algo que la politica de app_rw bloquea por diseno.
DATABASE_URL=postgresql://app_rw:CHANGE_ME@localhost:5432/ssot_contacts
DATABASE_ADMIN_URL=postgresql://ssot_admin:CHANGE_ME@localhost:5432/ssot_contacts
RELAY_DATABASE_URL=postgresql://app_relay:CHANGE_ME@localhost:5432/ssot_contacts

# Fase 3: clave de cifrado para tokens OAuth (AES-256-GCM), fuera de la BD.
# Debe decodificar a exactamente 32 bytes en base64, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Fase 4: identidad delegada (ADR-05).
SUPABASE_URL=
SUPABASE_JWKS_URL=

# Fase 3: OAuth 2.0 + PKCE con Google (UC-09). Scopes minimos: contactos.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
